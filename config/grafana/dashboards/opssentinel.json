{"title":"OpsSentinel usage","uid":"opssentinel","schemaVersion":39,"refresh":"10s","time":{"from":"now-1h","to":"now"},
 "panels":[
  {"id":1,"type":"stat","title":"LLM requests","gridPos":{"x":0,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prom"},"targets":[{"expr":"opssentinel_usage{name=\"llm_requests\"}"}]},
  {"id":2,"type":"stat","title":"Est. cost (USD)","gridPos":{"x":6,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prom"},"targets":[{"expr":"opssentinel_usage{name=\"est_cost_usd\"}"}]},
  {"id":3,"type":"stat","title":"Errors","gridPos":{"x":12,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prom"},"targets":[{"expr":"opssentinel_usage{name=\"errors\"}"}]},
  {"id":4,"type":"timeseries","title":"Hindsight operations","gridPos":{"x":0,"y":4,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prom"},"targets":[{"expr":"opssentinel_usage{name=~\"hindsight_.*\"}","legendFormat":"{{name}}"}]},
  {"id":5,"type":"timeseries","title":"Simulated p99 latency (ms)","gridPos":{"x":12,"y":4,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prom"},"targets":[{"expr":"ops_service_metric{metric=\"p99_ms\"}","legendFormat":"{{service}}"}]},
  {"id":6,"type":"logs","title":"Service logs (Loki)","gridPos":{"x":0,"y":12,"w":24,"h":8},"datasource":{"type":"loki","uid":"loki"},"targets":[{"expr":"{job=\"services\"} |= \"ERROR\""}]}
 ]}
